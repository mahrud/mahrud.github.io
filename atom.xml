---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text" xml:lang="en">{{ site.title }}</title>
  <link type="application/atom+xml" href="{{ site.url }}{{ site.baseurl }}/atom.xml" rel="self"/>
  <link type="text/html" href="{{ site.url }}{{ site.baseurl }}/" rel="alternate"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}</id>
  <rights>CC BY-SA</rights>

  {% for entry in site.journal %}{% if entry.status == "published" %}
  <entry>
    <title>{{ entry.title }}</title>
    <link href="{{ site.url }}{{ entry.url }}"/>
    <updated>{{ entry.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ site.baseurl }}{{ entry.id }}</id>
    <content type="html">{{ entry.content | xml_escape }}</content>
  </entry>
  {% endif %}{% endfor %}
</feed>
